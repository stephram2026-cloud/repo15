+	const name = "frontend"
+	script := `trap 'echo got TERM; sleep 0.2; echo cleaning up; sleep 0.2; echo bye; exit 0' TERM
+trap 'echo got HUP; exit 7' HUP
+echo ready
+while :; do sleep 0.05; done`
