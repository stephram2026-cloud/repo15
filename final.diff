diff --git a/src/app/daemon_stop_unix_test.go b/src/app/daemon_stop_unix_test.go
new file mode 100644
index 0000000..9e41956
--- /dev/null
+++ b/src/app/daemon_stop_unix_test.go
@@ -0,0 +1,202 @@
+//go:build !windows
+
+package app
+
+import (
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strconv"
+	"strings"
+	"syscall"
+	"testing"
+	"time"
+
+	"github.com/f1bonacc1/process-compose/src/command"
+	"github.com/f1bonacc1/process-compose/src/types"
+)
+
+// daemonProject runs a single daemon whose launcher starts `daemon` in the
+// background, records its PID and exits. It returns the runner, the channel
+// Run reports on, and the daemon's PID.
+func daemonProject(t *testing.T, daemon string, params types.ShutDownParams) (*ProjectRunner, chan error, int) {
+	t.Helper()
+	shell := command.DefaultShellConfig()
+	const name = "redis"
+	pidFile := filepath.Join(t.TempDir(), "pid")
+	runner, err := NewProjectRunner(&ProjectOpts{
+		project: &types.Project{
+			ShellConfig: shell,
+			Processes: map[string]types.ProcessConfig{
+				name: {
+					Name:        name,
+					ReplicaName: name,
+					IsDaemon:    true,
+					Executable:  shell.ShellCommand,
+					Args: []string{shell.ShellArgument,
+						fmt.Sprintf("%s >/dev/null 2>&1 & echo $! > %q", daemon, pidFile)},
+					ShutDownParams: params,
+				},
+			},
+		},
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	done := make(chan error, 1)
+	go func() { done <- runner.Run() }()
+	waitForProcessState(t, runner, name, types.ProcessStateLaunched, 10*time.Second)
+
+	data, err := os.ReadFile(pidFile)
+	if err != nil {
+		t.Fatal(err)
+	}
+	pid, err := strconv.Atoi(strings.TrimSpace(string(data)))
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = syscall.Kill(pid, syscall.SIGKILL) })
+	return runner, done, pid
+}
+
+// isRunning reports whether pid is a live process. An exited one that has not
+// been reaped yet does not count.
+func isRunning(pid int) bool {
+	if errors.Is(syscall.Kill(pid, 0), syscall.ESRCH) {
+		return false
+	}
+	data, err := os.ReadFile(fmt.Sprintf("/proc/%d/stat", pid))
+	if err != nil {
+		return true
+	}
+	// "pid (comm) state ...": the state follows the command name.
+	stat := string(data)
+	fields := strings.Fields(stat[strings.LastIndexByte(stat, ')')+1:])
+	return len(fields) == 0 || fields[0] != "Z"
+}
+
+func waitUntilGone(pid int, timeout time.Duration) bool {
+	deadline := time.Now().Add(timeout)
+	for isRunning(pid) {
+		if time.Now().After(deadline) {
+			return false
+		}
+		time.Sleep(20 * time.Millisecond)
+	}
+	return true
+}
+
+// A daemon that detached into its own session - as `redis-server --daemonize
+// yes` does - is out of reach once its launcher has exited. Stopping it without
+// a shutdown command must fail and say so, and must leave it reported as what
+// it is: still running. It must never be reported as stopped.
+func TestStopOfDetachedDaemonFails(t *testing.T) {
+	const name = "redis"
+	runner, done, pid := daemonProject(t, "setsid sleep 60", types.ShutDownParams{})
+
+	for attempt := 1; attempt <= 2; attempt++ {
+		err := runner.StopProcess(name)
+		if !errors.Is(err, errDaemonUnreachable) {
+			t.Fatalf("stop attempt %d returned %v, want %v", attempt, err, errDaemonUnreachable)
+		}
+		if !strings.Contains(err.Error(), "shutdown.command") {
+			t.Errorf("error does not say how to fix it: %v", err)
+		}
+		state, err := runner.GetProcessState(name)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if state.Status != types.ProcessStateLaunched {
+			t.Errorf("status after failed stop attempt %d = %s, want %s", attempt, state.Status, types.ProcessStateLaunched)
+		}
+	}
+	if !isRunning(pid) {
+		t.Fatal("the daemon is gone; the test no longer exercises a daemon that survives the stop")
+	}
+
+	// A restart must not launch a second copy next to the one it cannot stop.
+	if err := runner.RestartProcess(name); !errors.Is(err, errDaemonUnreachable) {
+		t.Errorf("restart returned %v, want %v", err, errDaemonUnreachable)
+	}
+
+	// Shutting the project down cannot stop it either, but must not hang on it.
+	shutdown := make(chan struct{})
+	go func() {
+		defer close(shutdown)
+		_ = runner.ShutDownProject()
+	}()
+	select {
+	case <-shutdown:
+	case <-time.After(10 * time.Second):
+		t.Fatal("project shutdown hangs on a daemon it cannot stop")
+	}
+	select {
+	case err := <-done:
+		if err != nil {
+			t.Errorf("project exited with %v", err)
+		}
+	case <-time.After(10 * time.Second):
+		t.Fatal("project did not exit")
+	}
+}
+
+// A daemon that stayed in its launcher's process group can be signalled. It is
+// reported as stopped when it is gone - not before, and not merely because a
+// signal was sent.
+func TestStopOfDaemonInLauncherGroup(t *testing.T) {
+	const name = "redis"
+	t.Run("exits on the signal", func(t *testing.T) {
+		runner, _, pid := daemonProject(t, "sleep 60", types.ShutDownParams{})
+		t.Cleanup(func() { _ = runner.ShutDownProject() })
+
+		if err := runner.StopProcess(name); err != nil {
+			t.Fatalf("stop: %v", err)
+		}
+		waitForProcessState(t, runner, name, types.ProcessStateCompleted, 10*time.Second)
+		if isRunning(pid) {
+			t.Error("daemon reported as stopped while still running")
+		}
+	})
+
+	t.Run("ignores the signal, no timeout", func(t *testing.T) {
+		runner, _, pid := daemonProject(t, `bash -c 'trap "" TERM; while :; do sleep 0.05; done'`, types.ShutDownParams{})
+		t.Cleanup(func() { _ = runner.ShutDownProject() })
+		// Let the daemon install its trap.
+		time.Sleep(300 * time.Millisecond)
+
+		if err := runner.StopProcess(name); err != nil {
+			t.Fatalf("stop: %v", err)
+		}
+		// Nothing kills it, so it must not be reported as stopped.
+		time.Sleep(time.Second)
+		if !isRunning(pid) {
+			t.Fatal("the daemon exited; the test no longer exercises a daemon that ignores the signal")
+		}
+		state, err := runner.GetProcessState(name)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if state.Status != types.ProcessStateTerminating {
+			t.Errorf("status = %s while the daemon is still running, want %s", state.Status, types.ProcessStateTerminating)
+		}
+		// Once it is really gone, the state follows.
+		_ = syscall.Kill(pid, syscall.SIGKILL)
+		waitForProcessState(t, runner, name, types.ProcessStateCompleted, 10*time.Second)
+	})
+
+	t.Run("ignores the signal, killed at the timeout", func(t *testing.T) {
+		runner, _, pid := daemonProject(t, `bash -c 'trap "" TERM; while :; do sleep 0.05; done'`,
+			types.ShutDownParams{ShutDownTimeout: 1})
+		t.Cleanup(func() { _ = runner.ShutDownProject() })
+		time.Sleep(300 * time.Millisecond)
+
+		if err := runner.StopProcess(name); err != nil {
+			t.Fatalf("stop: %v", err)
+		}
+		if !waitUntilGone(pid, 5*time.Second) {
+			t.Fatal("daemon survived its shutdown timeout")
+		}
+		waitForProcessState(t, runner, name, types.ProcessStateCompleted, 10*time.Second)
+	})
+}
