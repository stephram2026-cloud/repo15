+// matter on a later one.
+//
+// A graceful shutdown waits for every process to exit, and a process that
+// ignores its stop signal and has no shutdown timeout never does. Without a way
+// to insist, the only way out of that is to kill process-compose itself, which
+// leaves all of its processes behind.
+func handleSignals(signals <-chan os.Signal, shutDown func(), forceShutDown func(sig os.Signal), gap time.Duration) {
