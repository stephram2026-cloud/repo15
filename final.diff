+//
+// The watch path is the one exercised: it skips backoff, so nothing but an
+// explicit wait stands between the stop signal and the relaunch.
+func TestRestartWaitsForOldIncarnationToExit(t *testing.T) {
+	if runtime.GOOS == "windows" {
+		t.Skip("relies on Unix signals")
+	}
+	shell := command.DefaultShellConfig()
+	const name = "api"
+
+	tests := []struct {
+		name string
+		// cmd builds the process command from the server script.
+		cmd func(script string) string
+	}{
+		{
+			// The server is the command: its own exit is what has to be awaited.
+			name: "server is the command",
+			cmd:  func(script string) string { return "exec bash " + script },
+		},
+		{
+			// The server runs under a shell that dies on SIGTERM at once and
+			// leaves it behind, as `npm run`, a `cd x && server` one-liner or
+			// any launcher script does. The command is gone long before the
+			// server is; only its process group tells.
+			name: "server is behind a wrapper",
+			cmd:  func(script string) string { return "bash " + script + "; true" },
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			script, events := slowStopServer(t, t.TempDir())
+			runner, err := NewProjectRunner(&ProjectOpts{
+				project: &types.Project{
+					ShellConfig: shell,
+					Processes: map[string]types.ProcessConfig{
+						name: {
+							Name:        name,
+							ReplicaName: name,
+							Executable:  shell.ShellCommand,
+							Args:        []string{shell.ShellArgument, tt.cmd(script)},
+						},
+					},
+				},
+			})
+			if err != nil {
+				t.Fatal(err)
+			}
+			go func() { _ = runner.Run() }()
+			t.Cleanup(func() { _ = runner.ShutDownProject() })
