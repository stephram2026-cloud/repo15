+package pclog
+
+import (
+	"path/filepath"
+	"sync"
+	"testing"
+)
+
+// Lines can still arrive while - and after - the log is being closed: the
+// output of a process is read independently of the process ending. Closing must
+// drop them, not panic on a closed channel.
+func TestLoggerCloseWhileWriting(t *testing.T) {
+	for i := range 200 {
+		logger := NewLogger()
+		logger.Open(filepath.Join(t.TempDir(), "proc.log"), nil)
+
+		var writers sync.WaitGroup
+		start := make(chan struct{})
+		for w := range 4 {
+			writers.Add(1)
+			go func() {
+				defer writers.Done()
+				<-start
+				for range 50 {
+					if w%2 == 0 {
+						logger.Info("line", "proc", 0)
+					} else {
+						logger.Error("line", "proc", 0)
+					}
+				}
+			}()
+		}
+		close(start)
+		logger.Close()
+		writers.Wait()
+
+		// Closed for good: later writes are no-ops as well.
+		logger.Info("after close", "proc", 0)
+		if t.Failed() {
+			t.Fatalf("iteration %d", i)
+		}
+	}
+}
