 func (c *CmdWrapper) SetCmdArgs() {
 	c.cmd.SysProcAttr = &syscall.SysProcAttr{Setpgid: true}
 }
+
+// ownsGroup reports whether the command was started as the leader of its own
+// process group, either directly (Setpgid) or as a session leader (Setsid, the
+// PTY case). A command sharing process-compose's own group has no group of its
+// own to wait for or to signal by ID.
+func (c *CmdWrapper) ownsGroup() bool {
+	attr := c.cmd.SysProcAttr
+	return attr != nil && c.cmd.Process != nil &&
+		((attr.Setpgid && attr.Pgid == 0) || attr.Setsid)
+}
+
+func (c *CmdWrapper) waitGroupExit(ctx context.Context) bool {
+	// A command without a group of its own is followed through the descendants
+	// that were signalled along with it.
+	alive := c.hasRunningTree
+	if c.ownsGroup() {
+		pgid := c.Pid()
+		alive = func() bool { return isGroupAlive(pgid) }
+	}
+	interval := groupPollMin
+	timer := time.NewTimer(interval)
+	defer timer.Stop()
+	for {
+		if !alive() {
+			return true
+		}
+		select {
+		case <-ctx.Done():
+			return false
+		case <-timer.C:
+		}
+		interval = min(interval*2, groupPollMax)
+		timer.Reset(interval)
+	}
