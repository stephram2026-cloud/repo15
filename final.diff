+package cmd
+
+import (
+	"os"
+	"slices"
+	"syscall"
+	"testing"
+	"time"
+)
+
+// Every signal a terminal or a supervisor uses to end a program has to shut
+// the processes down first. SIGQUIT (Ctrl-\) is the one the Go runtime would
+// otherwise answer by itself - with a goroutine dump and an immediate exit that
+// leaves every process running.
+func TestShutdownSignals(t *testing.T) {
+	for _, sig := range []os.Signal{os.Interrupt, syscall.SIGTERM, syscall.SIGHUP, syscall.SIGQUIT} {
+		if !slices.Contains(shutdownSignals, sig) {
+			t.Errorf("%v does not shut the project down", sig)
+		}
+	}
+}
+
+func TestHandleSignals(t *testing.T) {
+	const gap = 200 * time.Millisecond
+	newHandler := func() (chan os.Signal, chan struct{}, chan os.Signal, chan struct{}) {
+		signals := make(chan os.Signal, 4)
+		shutDown := make(chan struct{}, 4)
+		forced := make(chan os.Signal, 4)
+		finished := make(chan struct{})
+		go func() {
+			defer close(finished)
+			handleSignals(signals,
+				func() { shutDown <- struct{}{} },
+				func(sig os.Signal) { forced <- sig },
+				gap)
+		}()
+		return signals, shutDown, forced, finished
+	}
+	expectShutDown := func(t *testing.T, shutDown chan struct{}) {
+		t.Helper()
+		select {
+		case <-shutDown:
+		case <-time.After(5 * time.Second):
+			t.Fatal("the first signal did not start a shutdown")
+		}
+	}
+
+	t.Run("first signal shuts down gracefully", func(t *testing.T) {
+		signals, shutDown, forced, _ := newHandler()
+		signals <- syscall.SIGQUIT
+		expectShutDown(t, shutDown)
+		select {
+		case sig := <-forced:
+			t.Errorf("a single %v forced the shutdown", sig)
+		case <-time.After(2 * gap):
+		}
+	})
+
+	t.Run("signals arriving together are one request", func(t *testing.T) {
+		signals, shutDown, forced, _ := newHandler()
+		// What a supervisor or a closing terminal sends.
+		signals <- syscall.SIGTERM
+		signals <- syscall.SIGHUP
+		expectShutDown(t, shutDown)
+		select {
+		case sig := <-forced:
+			t.Errorf("%v, delivered together with the first signal, forced the shutdown", sig)
+		case <-time.After(2 * gap):
+		}
+		select {
+		case <-shutDown:
+			t.Error("the shutdown was started twice")
+		default:
+		}
+	})
+
+	t.Run("a later signal forces the shutdown", func(t *testing.T) {
+		signals, shutDown, forced, finished := newHandler()
+		signals <- os.Interrupt
+		expectShutDown(t, shutDown)
+		time.Sleep(2 * gap)
+		signals <- syscall.SIGQUIT
+		select {
+		case sig := <-forced:
+			if sig != syscall.SIGQUIT {
+				t.Errorf("forced by %v, want %v", sig, syscall.SIGQUIT)
+			}
+		case <-time.After(5 * time.Second):
+			t.Fatal("a second signal did not force the shutdown")
+		}
+		select {
+		case <-finished:
+		case <-time.After(5 * time.Second):
+			t.Fatal("the handler kept running after forcing the shutdown")
+		}
+	})
+}
+
+func TestSignalExitCode(t *testing.T) {
+	if got := signalExitCode(syscall.SIGINT); got != 130 {
+		t.Errorf("exit code for SIGINT = %d, want 130", got)
+	}
+	if got := signalExitCode(syscall.SIGQUIT); got != 131 {
+		t.Errorf("exit code for SIGQUIT = %d, want 131", got)
+	}
+}
