+// slowStopServer writes a script standing in for a server that owns an
+// exclusive resource - a port, in real life - and takes a while to give it up
+// when asked to stop. The resource is a lock directory: a second copy started
+// while the first still holds it records a CONFLICT, the way a real server
+// would fail with "address already in use".
+func slowStopServer(t *testing.T, dir string) (script, events string) {
+	t.Helper()
+	lock := filepath.Join(dir, "port.lock")
+	events = filepath.Join(dir, "events")
+	script = filepath.Join(dir, "server.sh")
+	body := fmt.Sprintf(`trap 'sleep 0.6; rmdir %[1]q; exit 0' TERM
+if ! mkdir %[1]q 2>/dev/null; then
+  echo CONFLICT >> %[2]q
+  exit 98
+fi
+echo up >> %[2]q
+while :; do sleep 0.05; done
+`, lock, events)
+	if err := os.WriteFile(script, []byte(body), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	return script, events
+}
+
+func readEvents(t *testing.T, path string) string {
+	t.Helper()
+	data, err := os.ReadFile(path)
+	if err != nil && !errors.Is(err, os.ErrNotExist) {
+		t.Fatal(err)
+	}
+	return string(data)
+}
+
+// A restart must not launch the replacement while the old incarnation is still
