+// The project exits with the code of the process that ended it. The processes
+// terminated by the resulting shutdown exit non-zero too, and must not replace
+// that code with their own.
+func TestProjectExitCodeIsNotReplacedDuringShutdown(t *testing.T) {
+	if runtime.GOOS == "windows" {
+		t.Skip("uses POSIX shell syntax")
+	}
+	shell := command.DefaultShellConfig()
+	tests := []struct {
+		name     string
+		testsCmd string
+		wantCode int
+	}{
+		{name: "failing run", testsCmd: "sleep 0.3; exit 3", wantCode: 3},
+		{name: "passing run", testsCmd: "sleep 0.3; exit 0", wantCode: 0},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			processes := map[string]types.ProcessConfig{
+				"tests": {
+					Name:          "tests",
+					ReplicaName:   "tests",
+					Executable:    shell.ShellCommand,
+					Args:          []string{shell.ShellArgument, tt.testsCmd},
+					RestartPolicy: types.RestartPolicyConfig{ExitOnEnd: true},
+				},
+			}
+			// Services that are torn down with the project. Each carries a
+			// policy under which its own exit ends the project.
+			for _, svc := range []struct {
+				name   string
+				policy types.RestartPolicyConfig
+			}{
+				{"db", types.RestartPolicyConfig{Restart: types.RestartPolicyExitOnFailure}},
+				{"cache", types.RestartPolicyConfig{ExitOnEnd: true}},
+			} {
+				processes[svc.name] = types.ProcessConfig{
+					Name:          svc.name,
+					ReplicaName:   svc.name,
+					Executable:    shell.ShellCommand,
+					Args:          []string{shell.ShellArgument, getSleepCommand(60)},
+					RestartPolicy: svc.policy,
+				}
+			}
+			runner, err := NewProjectRunner(&ProjectOpts{
+				project: &types.Project{ShellConfig: shell, Processes: processes},
+			})
+			if err != nil {
+				t.Fatal(err)
+			}
+
+			done := make(chan error, 1)
+			go func() { done <- runner.Run() }()
+			var runErr error
+			select {
+			case runErr = <-done:
+			case <-time.After(20 * time.Second):
+				_ = runner.ShutDownProject()
+				t.Fatal("project did not exit")
+			}
+
+			gotCode := 0
+			var exitErr *ExitError
+			if errors.As(runErr, &exitErr) {
+				gotCode = exitErr.Code
+			} else if runErr != nil {
+				t.Fatalf("unexpected error: %v", runErr)
+			}
+			if gotCode != tt.wantCode {
+				t.Errorf("project exit code = %d, want %d", gotCode, tt.wantCode)
+			}
+		})
+	}
