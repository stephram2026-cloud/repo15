+
+// isGroupAlive reports whether the process group still has a live member.
+func isGroupAlive(pgid int) bool {
+	err := syscall.Kill(-pgid, 0)
+	if errors.Is(err, syscall.ESRCH) {
+		return false
+	}
+	// The group has members (EPERM means they belong to another user, as with
+	// an elevated process). That is not yet proof of life: members that have
+	// exited but were never reaped still count, and they stay forever when
+	// nothing reaps orphans - process-compose running as PID 1 of a container
+	// being the usual case.
+	return hasLiveGroupMember(pgid)
+}
+
+// exitCode returns the command's exit code. A command killed by a signal has
+// none of its own; it is reported as 128+signal rather than Go's -1, which is
+// not a valid exit status and reaches the caller of process-compose as 255.
+func exitCode(state *os.ProcessState) int {
+	if state == nil {
+		return -1
+	}
+	if status, ok := state.Sys().(syscall.WaitStatus); ok && status.Signaled() {
+		return exitCodeSignalBase + int(status.Signal())
+	}
+	return state.ExitCode()
+}
