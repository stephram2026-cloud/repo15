index 0000000..84d3380
--- /dev/null
+++ b/src/cmd/output_closed_unix.go
@@ -0,0 +1,68 @@
+//go:build !windows
+
+package cmd
+
+import (
+	"os"
+	"os/signal"
+	"syscall"
+
+	"github.com/rs/zerolog/log"
+	"golang.org/x/sys/unix"
+)
+
+// notifyOutputClosed calls report, once, when whatever reads the output of
+// process-compose has gone away - `process-compose up | head`, or a log
+// collector that died.
+//
+// Writing to a closed pipe raises SIGPIPE, and by default that kills a Go
+// program outright when the pipe is its standard output or error. Dying is the
+// right response; dying without stopping the processes first is not, and they
+// would be left running.
+//
+// Subscribing to SIGPIPE turns that death into a failed write, for every file
+// descriptor. So the signal alone says nothing: a client hanging up on the API
+// in the middle of a response raises it too. Only when standard output or
+// error itself turns out to be closed is it reported.
+func notifyOutputClosed(report func()) {
+	pipes := make(chan os.Signal, 1)
+	signal.Notify(pipes, syscall.SIGPIPE)
+	go func() {
+		reported := false
+		for range pipes {
+			if reported || !anyClosed(int(os.Stdout.Fd()), int(os.Stderr.Fd())) {
+				continue
+			}
+			// Keep draining afterwards: every further write to the closed
+			// output raises the signal again.
+			reported = true
+			log.Info().Msg("Output closed - Shutting down the running processes...")
+			report()
+		}
+	}()
+}
+
+// anyClosed reports whether the reading side of any of the given descriptors
+// has been closed.
+func anyClosed(fds ...int) bool {
+	polled := make([]unix.PollFd, len(fds))
+	for i, fd := range fds {
+		polled[i] = unix.PollFd{Fd: int32(fd), Events: unix.POLLOUT}
+	}
+	for {
+		_, err := unix.Poll(polled, 0)
+		if err == unix.EINTR {
+			continue
+		}
+		if err != nil {
+			return false
+		}
+		break
+	}
+	for _, fd := range polled {
+		if fd.Revents&(unix.POLLERR|unix.POLLHUP) != 0 {
+			return true
+		}
+	}
+	return false
+}
