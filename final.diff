new file mode 100644
index 0000000..12a37e1
--- /dev/null
+++ b/src/app/run_main_process_unix_test.go
@@ -0,0 +1,150 @@
+//go:build !windows
+
+package app
+
+import (
+	"errors"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"syscall"
+	"testing"
+	"time"
+
+	"github.com/f1bonacc1/process-compose/src/command"
+	"github.com/f1bonacc1/process-compose/src/types"
+)
+
+const (
+	// mainProcessHelperEnv selects the scenario the re-executed test binary
+	// plays out in place of `process-compose run tests`.
+	mainProcessHelperEnv = "PC_TEST_MAIN_PROCESS_SCENARIO"
+	// heartbeatEnv names the file a child of the foreground process keeps
+	// appending to for as long as it is alive.
+	heartbeatEnv = "PC_TEST_HEARTBEAT"
+)
+
+var mainProcessScenarios = map[string]struct {
+	db       string
+	tests    string
+	wantCode int
+}{
+	// A dependency fails while the foreground process is still running.
+	// The foreground process has a child of its own, which does not die with
+	// it unless it is stopped as well.
+	"dependency fails": {
+		db:       "sleep 0.5; exit 4",
+		tests:    `(while :; do echo beat >> "$` + heartbeatEnv + `"; sleep 0.05; done) & wait`,
+		wantCode: 4,
+	},
+	// The foreground process fails; the dependency is torn down with it.
+	"foreground fails": {db: "sleep 60 & wait", tests: "sleep 0.5; exit 3", wantCode: 3},
+	// The foreground process succeeds.
+	"foreground succeeds": {db: "sleep 60 & wait", tests: "sleep 0.5", wantCode: 0},
+}
+
+// The foreground process of `process-compose run` shares process-compose's own
+// process group, so that it keeps the terminal. Shutting the project down must
+// stop that process and its children without signalling the group itself:
+// doing so terminates process-compose and the script that launched it, which
+// then never sees the exit code nor gets to run its clean-up.
+//
+// The scenario runs in a re-executed copy of the test binary with a process
+// group of its own, standing in for process-compose, so that a stray group
+// signal shows up as that copy being killed rather than taking the test run
+// down.
+func TestRunDoesNotSignalItsOwnProcessGroup(t *testing.T) {
+	if scenario := os.Getenv(mainProcessHelperEnv); scenario != "" {
+		runMainProcessScenario(scenario)
+		return
+	}
+	for name, scenario := range mainProcessScenarios {
+		t.Run(name, func(t *testing.T) {
+			heartbeat := filepath.Join(t.TempDir(), "heartbeat")
+			helper := exec.Command(os.Args[0], "-test.run=^TestRunDoesNotSignalItsOwnProcessGroup$")
+			helper.Env = append(os.Environ(), mainProcessHelperEnv+"="+name, heartbeatEnv+"="+heartbeat)
+			helper.SysProcAttr = &syscall.SysProcAttr{Setpgid: true}
+			if err := helper.Start(); err != nil {
+				t.Fatal(err)
+			}
+			pgid := helper.Process.Pid
+			t.Cleanup(func() { _ = syscall.Kill(-pgid, syscall.SIGKILL) })
+
+			// The outcome is read from the process state below; Wait's error only
+			// restates a non-zero exit.
+			done := make(chan struct{})
+			go func() {
+				defer close(done)
+				_ = helper.Wait()
+			}()
+			select {
+			case <-done:
+			case <-time.After(30 * time.Second):
+				t.Fatal("project did not exit")
+			}
+
+			status, ok := helper.ProcessState.Sys().(syscall.WaitStatus)
+			if !ok {
+				t.Fatalf("unexpected process state %v", helper.ProcessState)
+			}
+			if status.Signaled() {
+				t.Fatalf("process-compose was killed by %v: stopping the foreground process signalled its own process group",
+					status.Signal())
+			}
+			if got := status.ExitStatus(); got != scenario.wantCode {
+				t.Errorf("exit code = %d, want %d", got, scenario.wantCode)
+			}
+
+			// The children of the foreground process have to be stopped along
+			// with it. Judged by what they do rather than by whether their PIDs
+			// are gone: an exited child stays around unreaped for as long as
+			// the system's init leaves it there.
+			before := countLinesIn(t, heartbeat)
+			time.Sleep(500 * time.Millisecond)
+			if after := countLinesIn(t, heartbeat); after != before {
+				t.Errorf("a child of the foreground process is still running after the project exited (%d beats since)", after-before)
+			}
+		})
+	}
+}
+
+func runMainProcessScenario(name string) {
+	scenario, ok := mainProcessScenarios[name]
+	if !ok {
+		os.Exit(99)
+	}
+	shell := command.DefaultShellConfig()
+	runner, err := NewProjectRunner(&ProjectOpts{
+		mainProcess: "tests",
+		project: &types.Project{
+			ShellConfig: shell,
+			Processes: map[string]types.ProcessConfig{
+				"db": {
+					Name:          "db",
+					ReplicaName:   "db",
+					Executable:    shell.ShellCommand,
+					Args:          []string{shell.ShellArgument, scenario.db},
+					RestartPolicy: types.RestartPolicyConfig{Restart: types.RestartPolicyExitOnFailure},
+				},
+				"tests": {
+					Name:        "tests",
+					ReplicaName: "tests",
+					Executable:  shell.ShellCommand,
+					Args:        []string{shell.ShellArgument, scenario.tests},
+				},
+			},
+		},
+	})
+	if err != nil {
+		os.Exit(98)
+	}
+	err = runner.Run()
+	var exitErr *ExitError
+	if errors.As(err, &exitErr) {
+		os.Exit(exitErr.Code)
+	}
+	if err != nil {
+		os.Exit(97)
+	}
+	os.Exit(0)
+}
