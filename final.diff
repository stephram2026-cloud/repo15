@@ -0,0 +1,34 @@
+//go:build !windows
+
+package cmd
+
+import (
+	"os"
+	"testing"
+)
+
+func TestAnyClosed(t *testing.T) {
+	reader, writer, err := os.Pipe()
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer writer.Close()
+	devNull, err := os.OpenFile(os.DevNull, os.O_WRONLY, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer devNull.Close()
+
+	if anyClosed(int(writer.Fd()), int(devNull.Fd())) {
+		t.Error("a pipe that is still being read was reported as closed")
+	}
+	if err := reader.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if !anyClosed(int(devNull.Fd()), int(writer.Fd())) {
+		t.Error("a pipe whose reader is gone was not reported as closed")
+	}
+	if anyClosed(int(devNull.Fd())) {
+		t.Error("a file was reported as closed")
+	}
+}
