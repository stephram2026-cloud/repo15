+	t.Cleanup(func() { _ = runner.ShutDownProject() })
+	waitForProcessState(t, runner, running, types.ProcessStateRunning, 10*time.Second)
+
+	runner.markShuttingDown()
+	if err := runner.StartProcess(late); err != nil {
+		t.Fatalf("start: %v", err)
+	}
+	if !waitForProcessDeregistered(runner, late, 10*time.Second) {
+		t.Fatal("a process started during shutdown is still registered")
+	}
+	state, err := runner.GetProcessState(late)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if state.Pid != 0 {
+		t.Errorf("a process started during shutdown was launched with pid %d", state.Pid)
+	}
