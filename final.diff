new file mode 100644
index 0000000..fada6a1
--- /dev/null
+++ b/src/command/group_other.go
@@ -0,0 +1,66 @@
+//go:build !windows && !linux
+
+package command
+
+import (
+	puproc "github.com/shirou/gopsutil/v4/process"
+)
+
+// hasLiveGroupMember has no portable way to tell a running member from an
+// unreaped one, so the kernel's word that the group has members is taken as is.
+// Lingering unreaped orphans are a property of Linux containers without an init
+// process; elsewhere the system's init reaps them promptly.
+func hasLiveGroupMember(_ int) bool {
+	return true
+}
+
+// isZombie reports whether pid has exited and is only waiting to be reaped.
+func isZombie(pid int) bool {
+	proc, err := puproc.NewProcess(int32(pid))
+	if err != nil {
+		return false
+	}
+	statuses, err := proc.Status()
+	if err != nil {
+		return false
+	}
+	for _, status := range statuses {
+		if status == puproc.Zombie {
+			return true
+		}
+	}
+	return false
+}
+
+// liveDescendants returns the processes descended from root, nearest first.
+// root itself is not included.
+func liveDescendants(root int) []int {
+	procs, err := puproc.Processes()
+	if err != nil {
+		return nil
+	}
+	children := make(map[int][]int, len(procs))
+	for _, proc := range procs {
+		ppid, err := proc.Ppid()
+		if err != nil {
+			continue
+		}
+		children[int(ppid)] = append(children[int(ppid)], int(proc.Pid))
+	}
+	var found []int
+	queue := []int{root}
+	seen := map[int]bool{root: true}
+	for len(queue) > 0 {
+		parent := queue[0]
+		queue = queue[1:]
+		for _, child := range children[parent] {
+			if seen[child] {
+				continue
+			}
+			seen[child] = true
+			queue = append(queue, child)
+			found = append(found, child)
+		}
+	}
+	return found
+}
