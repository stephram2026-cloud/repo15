diff --git a/src/command/group_linux.go b/src/command/group_linux.go
new file mode 100644
index 0000000..a0b9730
--- /dev/null
+++ b/src/command/group_linux.go
@@ -0,0 +1,128 @@
+package command
+
+import (
+	"bytes"
+	"os"
+	"strconv"
+)
+
+// procEntry is what /proc/<pid>/stat says about one process.
+type procEntry struct {
+	pid   int
+	ppid  int
+	pgrp  int
+	state byte
+}
+
+// isLive reports whether the process is still running, as opposed to having
+// exited without being reaped yet.
+func (e procEntry) isLive() bool {
+	return e.state != 'Z' && e.state != 'X'
+}
+
+// readProcs lists the processes visible in /proc. ok is false when /proc
+// yielded nothing usable, which proves nothing about what is running.
+func readProcs() (procs []procEntry, ok bool) {
+	entries, err := os.ReadDir("/proc")
+	if err != nil {
+		return nil, false
+	}
+	for _, entry := range entries {
+		pid, err := strconv.Atoi(entry.Name())
+		if err != nil {
+			continue
+		}
+		if proc, ok := readProc(pid); ok {
+			procs = append(procs, proc)
+		}
+	}
+	return procs, len(procs) > 0
+}
+
+func readProc(pid int) (procEntry, bool) {
+	stat, err := os.ReadFile("/proc/" + strconv.Itoa(pid) + "/stat")
+	if err != nil {
+		return procEntry{}, false
+	}
+	proc, ok := parseProcStat(stat)
+	proc.pid = pid
+	return proc, ok
+}
+
+// hasLiveGroupMember reports whether any process in the group is still running,
+// as opposed to having exited without being reaped yet. It is only consulted
+// once the kernel has confirmed that the group has members at all.
+func hasLiveGroupMember(pgid int) bool {
+	procs, ok := readProcs()
+	if !ok {
+		// Without /proc there is no telling the two apart; believe the kernel.
+		return true
+	}
+	for _, proc := range procs {
+		if proc.pgrp == pgid && proc.isLive() {
+			return true
+		}
+	}
+	return false
+}
+
+// isZombie reports whether pid has exited and is only waiting to be reaped.
+func isZombie(pid int) bool {
+	proc, ok := readProc(pid)
+	return ok && !proc.isLive()
+}
+
+// liveDescendants returns the running processes descended from root, nearest
+// first. root itself is not included.
+func liveDescendants(root int) []int {
+	procs, ok := readProcs()
+	if !ok {
+		return nil
+	}
+	children := make(map[int][]procEntry, len(procs))
+	for _, proc := range procs {
+		children[proc.ppid] = append(children[proc.ppid], proc)
+	}
+	var found []int
+	queue := []int{root}
+	seen := map[int]bool{root: true}
+	for len(queue) > 0 {
+		parent := queue[0]
+		queue = queue[1:]
+		for _, child := range children[parent] {
+			if seen[child.pid] {
+				continue
+			}
+			seen[child.pid] = true
+			queue = append(queue, child.pid)
+			if child.isLive() {
+				found = append(found, child.pid)
+			}
+		}
+	}
+	return found
+}
+
+// parseProcStat extracts the state, parent and process group from the contents
+// of /proc/<pid>/stat: "pid (comm) state ppid pgrp ...". The command name may
+// hold spaces and parentheses of its own, so the fields are located after the
+// last closing parenthesis.
+func parseProcStat(stat []byte) (procEntry, bool) {
+	end := bytes.LastIndexByte(stat, ')')
+	if end < 0 {
+		return procEntry{}, false
+	}
+	fields := bytes.Fields(stat[end+1:])
+	if len(fields) < 3 || len(fields[0]) != 1 {
+		return procEntry{}, false
+	}
+	ppid, err := strconv.Atoi(string(fields[1]))
+	if err != nil {
+		return procEntry{}, false
+	}
+	pgrp, err := strconv.Atoi(string(fields[2]))
+	if err != nil {
+		return procEntry{}, false
+	}
+	return procEntry{ppid: ppid, pgrp: pgrp, state: fields[0][0]}, true
+}
