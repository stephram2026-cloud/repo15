+//go:build !windows
+
+package command
+
+import (
+	"bufio"
+	"context"
+	"errors"
+	"os"
+	"os/exec"
+	"strings"
+	"syscall"
+	"testing"
+	"time"
+)
+
+// Wait must report the command's exit even while a child it left behind keeps
+// the output pipe open, and the pipe must stay readable afterwards.
+func TestWaitDoesNotDependOnOutputPipe(t *testing.T) {
+	cmd := BuildCommand("bash", []string{"-c", "echo first; (sleep 0.5; echo late) & exit 4"})
+	cmd.SetCmdArgs()
+	stdout, err := cmd.StdoutPipe()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := cmd.Start(); err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = cmd.Stop(int(syscall.SIGKILL), false) })
+
+	waited := make(chan struct{})
+	go func() {
+		_ = cmd.Wait()
+		close(waited)
+	}()
+	select {
+	case <-waited:
+	case <-time.After(5 * time.Second):
+		t.Fatal("Wait is blocked on the output pipe of a command that has exited")
+	}
+	if got := cmd.ExitCode(); got != 4 {
+		t.Errorf("exit code = %d, want 4", got)
+	}
+
+	// Everything is still delivered, including what arrives after the exit.
+	reader := bufio.NewReader(stdout)
+	for _, want := range []string{"first", "late"} {
+		line, err := reader.ReadString('\n')
+		if err != nil {
+			t.Fatalf("reading %q: %v", want, err)
+		}
+		if got := strings.TrimSpace(line); got != want {
+			t.Errorf("read %q, want %q", got, want)
+		}
+	}
+}
+
+func TestExitCodeOfSignalledCommand(t *testing.T) {
+	tests := []struct {
+		name string
+		args []string
+		want int
+	}{
+		{"SIGKILL", []string{"-c", "kill -KILL $$"}, 128 + int(syscall.SIGKILL)},
+		{"SIGTERM", []string{"-c", "kill -TERM $$"}, 128 + int(syscall.SIGTERM)},
+		{"exit status", []string{"-c", "exit 42"}, 42},
+		{"success", []string{"-c", "exit 0"}, 0},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			cmd := BuildCommand("bash", tt.args)
+			_ = cmd.Run()
+			if got := cmd.ExitCode(); got != tt.want {
+				t.Errorf("exit code = %d, want %d", got, tt.want)
+			}
+		})
+	}
+
+	t.Run("never started", func(t *testing.T) {
+		if got := BuildCommand("bash", nil).ExitCode(); got != -1 {
+			t.Errorf("exit code = %d, want -1", got)
+		}
+	})
+}
+
+// The group outlives its leader: a wrapper shell is killed outright while the
+// process it started takes its time. WaitGroupExit must see that through, and
+// the group must stay reachable by signal once the leader has been reaped.
+func TestWaitGroupExit(t *testing.T) {
+	// The child shrugs off SIGTERM; the wrapper in front of it does not.
+	cmd := BuildCommand("bash", []string{"-c", "bash -c 'trap \"\" TERM; while :; do sleep 0.05; done' & wait"})
+	cmd.SetCmdArgs()
+	if err := cmd.Start(); err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = syscall.Kill(-cmd.Pid(), syscall.SIGKILL) })
+	// Let the child install its trap.
+	time.Sleep(300 * time.Millisecond)
+
+	if err := cmd.Stop(int(syscall.SIGTERM), false); err != nil {
+		t.Fatalf("stop: %v", err)
+	}
+	_ = cmd.Wait()
+
+	ctx, cancel := context.WithTimeout(context.Background(), 300*time.Millisecond)
+	gone := cmd.WaitGroupExit(ctx)
+	cancel()
+	if gone {
+		t.Fatal("group reported gone while a member is still running")
+	}
+
+	// The leader is reaped by now; the rest of the group must still be killable.
+	if err := cmd.Stop(int(syscall.SIGKILL), false); err != nil {
+		t.Fatalf("kill after the leader was reaped: %v", err)
+	}
+	ctx, cancel = context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+	if !cmd.WaitGroupExit(ctx) {
+		t.Fatal("group still reported alive after SIGKILL")
+	}
+	// Its ID may be reused from here on, so nothing more is sent to it.
+	if err := cmd.Stop(int(syscall.SIGKILL), false); err != syscall.ESRCH {
+		t.Errorf("stop after the group was gone = %v, want %v", err, syscall.ESRCH)
+	}
+}
+
+// A command that shares our own process group has no group of its own.
+func TestWaitGroupExitWithoutOwnGroup(t *testing.T) {
+	cmd := &CmdWrapper{cmd: exec.Command("bash", "-c", "exit 0")}
+	if err := cmd.Start(); err != nil {
+		t.Fatal(err)
+	}
+	_ = cmd.Wait()
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	if !cmd.WaitGroupExit(ctx) {
+		t.Error("waited for a group the command does not own")
+	}
+}
+
+const sharedGroupHelperEnv = "PC_TEST_SHARED_GROUP_HELPER"
+
+// A command that shares our process group - the foreground process of
+// `process-compose run` - must be stopped together with its children, and
+// without the signal reaching the rest of the group: that is ourselves and
+// whoever launched us.
+//
+// The stop is performed by a re-executed copy of the test binary in a group of
+// its own, so that a signal sent to the group kills that copy, where it can be
+// observed, instead of the test run.
+func TestStopOfCommandSharingOurGroup(t *testing.T) {
+	if os.Getenv(sharedGroupHelperEnv) != "" {
+		stopCommandSharingOurGroup()
+		return
+	}
+	helper := exec.Command(os.Args[0], "-test.run=^TestStopOfCommandSharingOurGroup$")
+	helper.Env = append(os.Environ(), sharedGroupHelperEnv+"=1")
+	helper.SysProcAttr = &syscall.SysProcAttr{Setpgid: true}
+	if err := helper.Start(); err != nil {
+		t.Fatal(err)
+	}
+	pgid := helper.Process.Pid
+	t.Cleanup(func() { _ = syscall.Kill(-pgid, syscall.SIGKILL) })
+
+	// The outcome is read from the process state below; Wait's error only
+	// restates a non-zero exit.
+	done := make(chan struct{})
+	go func() {
+		defer close(done)
+		_ = helper.Wait()
+	}()
+	select {
+	case <-done:
+	case <-time.After(30 * time.Second):
+		t.Fatal("helper did not finish")
+	}
+	status, ok := helper.ProcessState.Sys().(syscall.WaitStatus)
+	if !ok {
+		t.Fatalf("unexpected process state %v", helper.ProcessState)
+	}
+	if status.Signaled() {
+		t.Fatalf("the stop signalled our own process group: helper killed by %v", status.Signal())
+	}
+	if code := status.ExitStatus(); code != 0 {
+		t.Fatalf("helper failed with exit code %d (see stopCommandSharingOurGroup)", code)
+	}
+	// The command's child lived in the helper's group. It must be gone too.
+	deadline := time.Now().Add(5 * time.Second)
+	for isGroupAlive(pgid) {
+		if time.Now().After(deadline) {
+			t.Fatal("a child of the stopped command is still running")
+		}
+		time.Sleep(20 * time.Millisecond)
+	}
+}
+
+func stopCommandSharingOurGroup() {
+	// No SetCmdArgs: the command stays in our process group. The child would
+	// survive its shell if it were not signalled as well.
+	cmd := BuildCommand("bash", []string{"-c", "sleep 60 & wait"})
+	if err := cmd.Start(); err != nil {
+		os.Exit(10)
+	}
+	time.Sleep(300 * time.Millisecond)
+	if err := cmd.Stop(int(syscall.SIGTERM), false); err != nil {
+		os.Exit(11)
+	}
+	_ = cmd.Wait()
+	if code := cmd.ExitCode(); code != 128+int(syscall.SIGTERM) {
+		os.Exit(12)
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+	if !cmd.WaitGroupExit(ctx) {
+		os.Exit(13)
+	}
+	// Everything is gone, so there is nothing left to signal.
+	if err := cmd.Stop(int(syscall.SIGKILL), false); !errors.Is(err, syscall.ESRCH) {
+		os.Exit(14)
+	}
+	os.Exit(0)
+}
