+// Stopping a process with a shutdown timeout arms a SIGKILL for when the
+// timeout expires. When the process is then restarted by its policy - a failed
+// readiness probe is the case here - that SIGKILL belongs to the launch that
+// was stopped, and must not land on its replacement.
+func TestStopTimeoutDoesNotKillReplacement(t *testing.T) {
+	if runtime.GOOS == "windows" {
+		t.Skip("relies on Unix signals")
+	}
+	launches := filepath.Join(t.TempDir(), "launches")
+	proc := &types.ProcessConfig{
+		Name:        "svc",
+		ReplicaName: "svc",
+		Command:     fmt.Sprintf("echo launched >> %q; exec sleep 60", launches),
+		RestartPolicy: types.RestartPolicyConfig{
+			Restart:        types.RestartPolicyAlways,
+			BackoffSeconds: 1,
+		},
+		ShutDownParams: types.ShutDownParams{ShutDownTimeout: 2},
+		// Fails for the first launch only.
+		ReadinessProbe: &health.Probe{
+			Exec: &health.ExecProbe{
+				Command: fmt.Sprintf("test $(wc -l < %q) -ge 2", launches),
+			},
+			FailureThreshold: 1,
+			PeriodSeconds:    1,
+			InitialDelay:     1,
+		},
+	}
+	shell := command.DefaultShellConfig()
+	proc.AssignProcessExecutableAndArgs(shell, "")
+
+	p := NewProcess(
+		withProcConf(proc),
+		// The probe runs through the shell as well.
+		withShellConfig(*shell),
+		withLogger(pclog.NewNilLogger()),
+		withProcState(&types.ProcessState{}),
+		withProcLog(pclog.NewLogBuffer(100)),
+	)
+	finished := make(chan struct{})
+	go func() {
+		defer close(finished)
+		_ = p.run()
+	}()
+	t.Cleanup(func() {
+		_ = p.shutDownNoRestart()
+		<-finished
+	})
+
+	if !waitForLineCount(t, launches, 2, 15*time.Second) {
+		t.Fatalf("process was not restarted by its readiness probe; launches: %d", countLinesIn(t, launches))
+	}
+	// Well past the shutdown timeout of the launch that was stopped.
+	time.Sleep(4 * time.Second)
+	if got := countLinesIn(t, launches); got != 2 {
+		t.Errorf("process was launched %d times, want 2: the replacement was killed", got)
+	}
+	if restarts := p.getState().Restarts; restarts != 1 {
+		t.Errorf("restarts = %d, want 1", restarts)
+	}
+}
