--- /dev/null
+++ b/src/command/command_wrapper_pty_unix_test.go
@@ -0,0 +1,96 @@
+//go:build !windows
+
+package command
+
+import (
+	"bufio"
+	"strings"
+	"syscall"
+	"testing"
+	"time"
+)
+
+// ptyScript reports which signal stopped it and takes a moment to shut down,
+// writing as it goes - the way a server logs its own shutdown.
+const ptyScript = `trap 'echo got TERM; sleep 0.2; echo cleaning up; sleep 0.2; echo bye; exit 0' TERM
+trap 'echo got HUP; exit 7' HUP
+echo ready
+while :; do sleep 0.05; done`
+
+// readPtyLines reads the terminal until it ends and returns what was written.
+func readPtyLines(t *testing.T, reader *bufio.Reader) string {
+	t.Helper()
+	var out strings.Builder
+	for {
+		line, err := reader.ReadString('\n')
+		out.WriteString(line)
+		if err != nil {
+			return out.String()
+		}
+	}
+}
+
+func startPtyScript(t *testing.T, interactive bool) (*CmdWrapperPty, *bufio.Reader) {
+	t.Helper()
+	cmd := BuildPtyCommand("bash", []string{"-c", ptyScript}, interactive)
+	stdout, err := cmd.StdoutPipe()
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = syscall.Kill(-cmd.Pid(), syscall.SIGKILL) })
+	reader := bufio.NewReader(stdout)
+	line, err := reader.ReadString('\n')
+	if err != nil || !strings.Contains(line, "ready") {
+		t.Fatalf("command did not come up: %q, %v", line, err)
+	}
+	return cmd, reader
+}
+
+// A command that runs on a terminal only to get one - `is_tty`, for coloured
+// output - is stopped like any other: with the signal that was asked for, and
+// with its terminal left open, so that it can still write while it shuts down
+// and exits with its own status.
+func TestPtyStopKeepsTerminalOpen(t *testing.T) {
+	cmd, reader := startPtyScript(t, false)
+
+	if err := cmd.Stop(int(syscall.SIGTERM), false); err != nil {
+		t.Fatalf("stop: %v", err)
+	}
+	output := make(chan string, 1)
+	go func() { output <- readPtyLines(t, reader) }()
+	_ = cmd.Wait()
+
+	var got string
+	select {
+	case got = <-output:
+	case <-time.After(10 * time.Second):
+		t.Fatal("terminal output did not end after the command exited")
+	}
+	for _, want := range []string{"got TERM", "cleaning up", "bye"} {
+		if !strings.Contains(got, want) {
+			t.Errorf("output written while shutting down is missing %q; got %q", want, got)
+		}
+	}
+	if strings.Contains(got, "got HUP") {
+		t.Errorf("command was sent SIGHUP instead of the requested signal; got %q", got)
+	}
+	if code := cmd.ExitCode(); code != 0 {
+		t.Errorf("exit code = %d, want the command's own 0", code)
+	}
+}
+
+// An interactive session is still ended by hanging up.
+func TestPtyStopHangsUpInteractiveSession(t *testing.T) {
+	cmd, _ := startPtyScript(t, true)
+
+	if err := cmd.Stop(int(syscall.SIGTERM), false); err != nil {
+		t.Fatalf("stop: %v", err)
+	}
+	if _, err := cmd.GetPty().Write([]byte("x")); err == nil {
+		t.Error("terminal is still open after the session was stopped")
+	}
+	_ = cmd.Wait()
+	if code := cmd.ExitCode(); code != 7 {
+		t.Errorf("exit code = %d, want 7: the session should have received SIGHUP", code)
+	}
+}
