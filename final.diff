@@ -0,0 +1,61 @@
+package command
+
+import (
+	"syscall"
+	"testing"
+)
+
+func TestParseProcStat(t *testing.T) {
+	tests := []struct {
+		name      string
+		stat      string
+		wantState byte
+		wantPpid  int
+		wantPgrp  int
+		wantOk    bool
+	}{
+		{
+			name:      "running",
+			stat:      "4242 (python3) S 4241 4200 4200 0 -1 4194304 1 0",
+			wantState: 'S', wantPpid: 4241, wantPgrp: 4200, wantOk: true,
+		},
+		{
+			name:      "zombie",
+			stat:      "15 (python3) Z 1 14 14 0 -1 4228100 0 0",
+			wantState: 'Z', wantPpid: 1, wantPgrp: 14, wantOk: true,
+		},
+		{
+			// The command name is whatever the process says it is.
+			name:      "name with spaces and parentheses",
+			stat:      "77 (tmux: server (1) R) R 1 77 77 0 -1 0 0 0",
+			wantState: 'R', wantPpid: 1, wantPgrp: 77, wantOk: true,
+		},
+		{name: "truncated", stat: "77 (bash) S 1", wantOk: false},
+		{name: "garbage", stat: "not a stat line", wantOk: false},
+		{name: "empty", stat: "", wantOk: false},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			proc, ok := parseProcStat([]byte(tt.stat))
+			if ok != tt.wantOk {
+				t.Fatalf("ok = %v, want %v", ok, tt.wantOk)
+			}
+			if !ok {
+				return
+			}
+			if proc.state != tt.wantState || proc.pgrp != tt.wantPgrp || proc.ppid != tt.wantPpid {
+				t.Errorf("got state %q ppid %d pgrp %d, want state %q ppid %d pgrp %d",
+					proc.state, proc.ppid, proc.pgrp, tt.wantState, tt.wantPpid, tt.wantPgrp)
+			}
+			if live := proc.isLive(); live != (tt.wantState != 'Z') {
+				t.Errorf("isLive = %v for state %q", live, proc.state)
+			}
+		})
+	}
+}
+
+func TestHasLiveGroupMember(t *testing.T) {
+	if !hasLiveGroupMember(syscall.Getpgrp()) {
+		t.Error("our own process group has no live member")
+	}
+}
