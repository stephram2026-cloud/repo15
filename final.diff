+// A graceful shutdown waits for a process that ignores its stop signal and has
+// no shutdown timeout for as long as it likes to run. Forcing the shutdown must
+// end the project regardless, and leave nothing running behind it.
+func TestForceShutDownProject(t *testing.T) {
+	if runtime.GOOS == "windows" {
+		t.Skip("relies on Unix signals")
+	}
+	shell := command.DefaultShellConfig()
+	marker := filepath.Join(t.TempDir(), "beats")
+	runner, err := NewProjectRunner(&ProjectOpts{
+		project: &types.Project{
+			ShellConfig: shell,
+			Processes: map[string]types.ProcessConfig{
+				"stubborn": {
+					Name:        "stubborn",
+					ReplicaName: "stubborn",
+					Executable:  shell.ShellCommand,
+					Args: []string{shell.ShellArgument,
+						fmt.Sprintf("trap '' TERM; while :; do echo beat >> %q; sleep 0.05; done", marker)},
+				},
+				// Still waiting for a dependency that never completes.
+				"pending": {
+					Name:        "pending",
+					ReplicaName: "pending",
+					Executable:  shell.ShellCommand,
+					Args:        []string{shell.ShellArgument, "echo started >> " + marker + ".pending"},
+					DependsOn: types.DependsOnConfig{
+						"stubborn": {Condition: types.ProcessConditionCompleted},
+					},
+				},
+			},
+		},
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	done := make(chan error, 1)
+	go func() { done <- runner.Run() }()
+	if !waitForLineCount(t, marker, 1, 10*time.Second) {
+		t.Fatal("process never started")
+	}
+	proc := runner.getRunningProcess("stubborn")
+	if proc == nil {
+		t.Fatal("process is not registered")
+	}
+	t.Cleanup(func() { _ = proc.command.Stop(int(syscall.SIGKILL), false) })
+
+	go func() { _ = runner.ShutDownProject() }()
+	select {
+	case err := <-done:
+		t.Fatalf("project exited (%v) although a process ignores its stop signal", err)
+	case <-time.After(time.Second):
+	}
+
+	runner.ForceShutDownProject(130)
+	select {
+	case err := <-done:
+		var exitErr *ExitError
+		if !errors.As(err, &exitErr) || exitErr.Code != 130 {
+			t.Errorf("project exited with %v, want exit code 130", err)
+		}
+	case <-time.After(10 * time.Second):
+		t.Fatal("project did not exit after a forced shutdown")
+	}
+
+	before := countLinesIn(t, marker)
+	time.Sleep(300 * time.Millisecond)
+	if after := countLinesIn(t, marker); after != before {
+		t.Error("the process is still running after a forced shutdown")
+	}
+	if countLinesIn(t, marker+".pending") != 0 {
+		t.Error("a process that was waiting for its dependency was launched by the forced shutdown")
+	}
+}
