+// incarnation is one launch of a process's command. A Process outlives its
+// command when a restart policy relaunches it, so anything that acts on "the
+// command that was running when the stop was requested" has to hold on to that
+// launch rather than look the command up again later.
+type incarnation struct {
+	cmd command.Commander
+	// exited is closed once the command has exited and, if it was stopped
+	// through its process group, once that group is empty as well.
+	exited chan struct{}
+	// groupSignalled records that a stop signal was sent to the command's
+	// whole process group, which makes the group ours to wait for.
+	groupSignalled atomic.Bool
+}
+
+// outputStream tracks the goroutine reading one of the command's output pipes.
+type outputStream struct {
+	// done is closed when the reader has reached the end of the stream.
+	done chan struct{}
+	// blockedSince is when (UnixNano) the reader last began waiting for input,
+	// or 0 while it is handling a line. A reader that stays blocked has
+	// consumed everything written so far.
+	blockedSince atomic.Int64
+	// ownsPipe is set when the reader should close the pipe once it is done
+	// with it. A PTY is shared with the terminal view and closed elsewhere.
+	ownsPipe bool
+}
+
+func newOutputStream(ownsPipe bool) *outputStream {
+	return &outputStream{done: make(chan struct{}), ownsPipe: ownsPipe}
+}
+
+// idleSince returns the moment from which the reader has been continuously
+// waiting for input, not earlier than notBefore. ok is false while the reader
+// is busy with a line.
+func (s *outputStream) idleSince(notBefore time.Time) (since time.Time, ok bool) {
+	blocked := s.blockedSince.Load()
+	if blocked == 0 {
+		return time.Time{}, false
+	}
+	since = time.Unix(0, blocked)
+	if since.Before(notBefore) {
+		since = notBefore
+	}
+	return since, true
+}
